# =============================================================================
# Collectra email — ONE sender mailbox (not one per invitee)
# =============================================================================
#
# What this file is for:
#   Collectra needs ONE email account that can SEND mail (like a company
#   mailbox). Invitees from your spreadsheet are RECIPIENTS — they are already
#   in Collectra as pending invitations. Do NOT put their emails here.
#
# Example for Safisana:
#   Put YOUR mailbox here (e.g. harold.djah@safisana.org or a Gmail you control).
#   When you click Resend, Collectra emails people like berend@safisana.org,
#   annorg7@gmail.com, etc. automatically from the pending list.
#
# Setup (once):
#   mkdir -p ~/.config/collectra
#   cp collectra-hq/local-bin/email.env.example ~/.config/collectra/email.env
#   chmod 600 ~/.config/collectra/email.env
#   # edit ~/.config/collectra/email.env — fill ONLY the four values below
#   # restart Collectra HQ (./local-bin/start-collectra)
#
# Never commit the filled ~/.config/collectra/email.env file.
#
# --- Google / Gmail App Password (this is NOT each user's password) ---
# 1. Sign into the ONE Google account you will send FROM
#    (e.g. harold.djah@safisana.org if it is Google Workspace, or your Gmail).
# 2. Turn on 2-Step Verification if it is not already on:
#      Google Account → Security → 2-Step Verification
# 3. Create an App password:
#      Google Account → Security → App passwords
#      App: Mail  |  Device: Other → "Collectra"
#      Copy the 16-character password (spaces optional)
# 4. Paste that into COLLECTRA_EMAIL_PASSWORD below — ALWAYS use double quotes.
#    Spaces are OK inside quotes. Or remove spaces: abcdEFGHijklMNOP
#    This is NOT the normal login password, and NOT invitees' passwords.
#    Invitees set their own Collectra password when they open the join link.
# =============================================================================

# The mailbox Collectra sends FROM (ONE account only)
COLLECTRA_EMAIL_LOGIN="harold.djah@safisana.org"

# 16-char Google App Password — quotes required if it has spaces
COLLECTRA_EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"

COLLECTRA_EMAIL_SMTP_HOST="smtp.gmail.com"
COLLECTRA_EMAIL_SMTP_PORT=587
COLLECTRA_EMAIL_USE_TLS=1

# "From:" shown on invitation emails (usually same as LOGIN)
COLLECTRA_DEFAULT_FROM_EMAIL="harold.djah@safisana.org"
COLLECTRA_SERVER_EMAIL="harold.djah@safisana.org"
