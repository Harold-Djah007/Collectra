# Copy to ~/.config/collectra/email.env and fill in real values.
# Never commit the filled file.
#
# mkdir -p ~/.config/collectra
# cp collectra-hq/local-bin/email.env.example ~/.config/collectra/email.env
# chmod 600 ~/.config/collectra/email.env

COLLECTRA_EMAIL_LOGIN=you@gmail.com
COLLECTRA_EMAIL_PASSWORD=your-16-char-gmail-app-password
COLLECTRA_EMAIL_SMTP_HOST=smtp.gmail.com
COLLECTRA_EMAIL_SMTP_PORT=587
COLLECTRA_EMAIL_USE_TLS=1
COLLECTRA_DEFAULT_FROM_EMAIL=you@gmail.com
COLLECTRA_SERVER_EMAIL=you@gmail.com
