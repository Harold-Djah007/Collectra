#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
default_project_root=$(cd -- "$script_dir/.." && pwd)
project_root="${COLLECTRA_PROJECT_ROOT:-$default_project_root}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/collectra"
bind_host="${COLLECTRA_BIND_HOST:-0.0.0.0}"
bind_port="${COLLECTRA_BIND_PORT:-8000}"
web_workers="${COLLECTRA_WEB_WORKERS:-1}"
case_index_audit_domain="${COLLECTRA_CASE_INDEX_AUDIT_DOMAIN:-safisana}"
case_index_auto_repair="${COLLECTRA_CASE_INDEX_AUTO_REPAIR:-1}"

mkdir -p "$state_root"
cd "$project_root"

celery_pid=""
pillowtop_pid=""
web_pid=""

exec 9>"$state_root/launcher.lock"
if ! flock -n 9; then
    echo "Collectra is already running. Stop its launcher before starting another instance." >&2
    exit 1
fi

if [[ ! "$bind_port" =~ ^[0-9]+$ ]] || (( bind_port < 1 || bind_port > 65535 )); then
    echo "COLLECTRA_BIND_PORT must be an integer from 1 through 65535." >&2
    exit 2
fi
if [[ ! "$web_workers" =~ ^[1-9][0-9]*$ ]]; then
    echo "COLLECTRA_WEB_WORKERS must be a positive integer." >&2
    exit 2
fi
if [[ "$case_index_auto_repair" != 0 && "$case_index_auto_repair" != 1 ]]; then
    echo "COLLECTRA_CASE_INDEX_AUTO_REPAIR must be 0 or 1." >&2
    exit 2
fi

stop_managed_process() {
    local pid_file="$1"
    local expected_command="$2"

    if [[ ! -f "$pid_file" ]]; then
        return
    fi

    local pid
    pid="$(<"$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" >/dev/null 2>&1; then
        local command_line
        command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
        if [[ "$command_line" == *"$expected_command"* ]]; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    fi
    rm -f "$pid_file"
}

cleanup() {
    echo
    echo "Stopping Collectra background workers..."
    for pid in "$web_pid" "$pillowtop_pid" "$celery_pid"; do
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" >/dev/null 2>&1; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    done
    rm -f "$state_root/pillowtop.pid" "$state_root/celery.pid"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if fuser "${bind_port}/tcp" >/dev/null 2>&1; then
    echo "Port ${bind_port} is already in use. Stop its owner before starting Collectra." >&2
    exit 1
fi

echo "Waiting for Docker Desktop..."
until docker info >/dev/null 2>&1; do
    sleep 3
done

wsl_ip="$(hostname -I | awk '{print $1}')"
if [[ -z "$wsl_ip" ]]; then
    echo "Unable to determine the WSL IP address." >&2
    exit 1
fi

if [[ -n "${COLLECTRA_BASE_ADDRESS:-}" ]]; then
    export COLLECTRA_DEFAULT_PROTOCOL="${COLLECTRA_DEFAULT_PROTOCOL:-https}"
else
    export COLLECTRA_BASE_ADDRESS="${wsl_ip}:${bind_port}"
    export COLLECTRA_DEFAULT_PROTOCOL="${COLLECTRA_DEFAULT_PROTOCOL:-http}"
fi
export COMMCARE_HOST="http://${wsl_ip}:${bind_port}"

echo "Collectra address: http://localhost:${bind_port}"
echo "Published mobile address: ${COLLECTRA_DEFAULT_PROTOCOL}://${COLLECTRA_BASE_ADDRESS}"
echo "Formplayer callback: ${COMMCARE_HOST}"
echo "Starting Collectra services..."

bash ./scripts/docker up -d \
    postgres couch redis elasticsearch6 \
    zookeeper kafka minio

if curl --silent --fail --max-time 2 http://localhost:8080/serverup >/dev/null 2>&1; then
    echo "Formplayer is already healthy on port 8080; reusing it."
else
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)8080$'; then
        echo "Port 8080 is already in use, but the service there is not a healthy Formplayer." >&2
        echo "Stop the process/container using port 8080, then start Collectra again." >&2
        exit 1
    fi
    bash ./scripts/docker up -d --force-recreate formplayer
fi

echo "Waiting for PostgreSQL..."
until docker exec hqservice-postgres-1 \
    pg_isready -U commcarehq -d commcarehq >/dev/null 2>&1; do
    sleep 2
done

echo "Waiting for Kafka..."
until docker inspect hqservice-kafka-1 \
    --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null \
    | grep -q '^healthy$'; do
    sleep 2
done

echo "Waiting for Formplayer..."
until curl --silent --fail --max-time 2 \
    http://localhost:8080/serverup >/dev/null 2>&1; do
    sleep 2
done

if fuser "${bind_port}/tcp" >/dev/null 2>&1; then
    echo "Port ${bind_port} became busy during startup. Stop its owner before retrying." >&2
    exit 1
fi

# Stop legacy Docker workers. The managed workers below use the current checkout.
docker stop hqservice-pillowtop-1 hqservice-celery-1 >/dev/null 2>&1 || true
stop_managed_process "$state_root/pillowtop.pid" "manage.py run_ptop"
stop_managed_process "$state_root/celery.pid" "celery -A corehq worker"

echo "Checking Collectra configuration..."
uv run python manage.py check

celery_queues="celery,analytics_queue,async_restore_queue,case_import_queue,email_queue,export_download_queue,saved_exports_queue,submission_reprocessing_queue"

echo "Starting Celery worker..."
uv run celery -A corehq worker \
    --loglevel=INFO \
    --pool=solo \
    --queues="$celery_queues" \
    >"$state_root/celery.log" 2>&1 9>&- &
celery_pid=$!
echo "$celery_pid" >"$state_root/celery.pid"

echo "Starting CaseToElasticsearchPillow..."
uv run python manage.py run_ptop \
    --pillow-name CaseToElasticsearchPillow \
    >"$state_root/pillowtop.log" 2>&1 9>&- &
pillowtop_pid=$!
echo "$pillowtop_pid" >"$state_root/pillowtop.pid"

sleep 5
if ! kill -0 "$celery_pid" >/dev/null 2>&1; then
    echo "Celery failed to start. Recent log output:" >&2
    tail -50 "$state_root/celery.log" >&2 || true
    exit 1
fi
if ! kill -0 "$pillowtop_pid" >/dev/null 2>&1; then
    echo "CaseToElasticsearchPillow failed to start. Recent log output:" >&2
    tail -50 "$state_root/pillowtop.log" >&2 || true
    exit 1
fi

if [[ -n "$case_index_audit_domain" ]]; then
    echo "Auditing case search index for domain: $case_index_audit_domain"
    audit_args=("$case_index_audit_domain")
    if [[ "$case_index_auto_repair" == 1 ]]; then
        audit_args+=(--repair)
    fi
    if ! uv run python manage.py audit_case_search_index "${audit_args[@]}"; then
        echo "Case search index audit failed." >&2
        echo "Pillowtop log: $state_root/pillowtop.log" >&2
        exit 1
    fi
fi

echo "Background logs: $state_root"
echo "Case index audit domain: ${case_index_audit_domain:-disabled}"
echo "Starting Collectra at http://localhost:${bind_port} with ${web_workers} web worker(s)"
echo "Press Ctrl+C once to stop Collectra and its background workers."

uv run gunicorn \
    --bind "${bind_host}:${bind_port}" \
    --workers "$web_workers" \
    --worker-class gevent \
    --timeout 900 \
    --keep-alive 65 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile - \
    --error-logfile - \
    deployment.gunicorn.collectra_wsgi:application 9>&- &
web_pid=$!
wait "$web_pid"
