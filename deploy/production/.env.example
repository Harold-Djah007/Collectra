# Public hostname. Create its DNS A record before starting Caddy.
COLLECTRA_HOST=collectra.example.com
COLLECTRA_ADMIN_EMAIL=admin@example.com
CADDY_ACME_EMAIL=admin@example.com

# Web sessions expire after eight hours and after eight hours of inactivity.
COLLECTRA_SESSION_AGE_SECONDS=28800
COLLECTRA_INACTIVITY_TIMEOUT_MINUTES=480

# Generate independent secrets, for example: openssl rand -hex 32
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
COUCHDB_PASSWORD=replace-with-a-random-couchdb-password
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
FORMPLAYER_AUTH_KEY=replace-with-a-random-formplayer-key

POSTGRES_USER=commcarehq
POSTGRES_DB=commcarehq
FORMPLAYER_DATABASE=formplayer
COUCHDB_USER=collectra
COUCHDB_DATABASE=commcarehq
MINIO_ROOT_USER=collectra-minio

# Use an absolute host path and copy completed backups off the server.
COLLECTRA_BACKUP_DIR=/srv/collectra/backups
COLLECTRA_IMAGE_TAG=production
# Health checks fail before free space falls below this safety margin.
COLLECTRA_MIN_FREE_DISK_GB=10
