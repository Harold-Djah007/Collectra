[Unit]
Description=Collectra service and backup checks for %i
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/collectra/deploy/production
ExecStart=/usr/bin/python3 /srv/collectra/deploy/production/runtime-check.py --domains %i
TimeoutStartSec=360
UMask=0077
