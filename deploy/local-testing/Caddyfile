:80 {
	encode zstd gzip

	request_body {
		max_size 500MB
	}

	handle_path /formplayer/* {
		reverse_proxy host.docker.internal:8080 {
			header_up -Origin
		}
	}

	@static path /static/*
	header @static {
		Cache-Control "public, max-age=21600, stale-while-revalidate=604800"
		X-Content-Type-Options "nosniff"
		-Set-Cookie
	}

	reverse_proxy host.docker.internal:8001 {
		transport http {
			keepalive 30s
			keepalive_idle_conns 64
		}
	}
}
