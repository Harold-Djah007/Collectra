<resources>
    <style name="Collectra.Toolbar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorControlNormal">@color/collectra_ink</item>
    </style>
    <string name="collectra_search_forms">Search forms and groups</string>
    <string name="collectra_saved_label">Saved forms</string>
    <string name="collectra_drafts_label">Drafts</string>
    <string name="collectra_saved_count">%1$d\nSaved forms</string>
    <string name="collectra_drafts_count">%1$d\nDrafts</string>
    <string name="collectra_nav_home">Home</string>
    <string name="collectra_nav_forms">Forms</string>
    <string name="collectra_nav_account">Account</string>
    <style name="Collectra.Workspace.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/cc_brand_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Collectra.Workspace.Secondary" parent="Collectra.Workspace.Primary">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/collectra_ink</item>
        <item name="strokeColor">@color/collectra_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
