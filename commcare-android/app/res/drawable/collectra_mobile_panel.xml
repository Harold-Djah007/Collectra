<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/collectra_panel_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/collectra_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/collectra_outline" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
