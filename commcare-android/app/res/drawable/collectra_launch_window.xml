<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window background matching the Collectra splash so Android does not
     flash a light/white system screen before DispatchActivity draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/collectra_hero_banner_bg" />
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center"
        android:drawable="@drawable/collectra_mark" />
</layer-list>
