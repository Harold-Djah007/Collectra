<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Collectra brand lockup with motion-friendly IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collectra_brand_masthead_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/collectra_hero_banner_bg"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/collectra_brand_mark"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/collectra_mark" />

            <TextView
                android:id="@+id/collectra_brand_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="-0.02"
                android:text="@string/collectra_brand_name"
                android:textColor="@color/collectra_signal"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kept for CustomBanner / LoginActivityUIController compatibility; hidden by default. -->
        <ImageView
            android:id="@+id/main_top_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/application_name"
            android:maxHeight="72dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>
</FrameLayout>
