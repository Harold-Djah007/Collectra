<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/collectra_mark" android:contentDescription="@null" />
    <TextView android:id="@+id/collectra_toolbar_title_text"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:fontFamily="@font/outfit_semibold"
        android:text="@string/collectra_brand_name" android:textColor="@color/collectra_ink"
        android:textSize="20sp" />
</LinearLayout>
