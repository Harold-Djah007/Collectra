<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collectra_home_masthead_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:id="@+id/collectra_home_brand_row"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/main_top_banner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/application_name"
            android:scaleType="fitCenter"
            android:src="@drawable/collectra_mark" />

        <TextView
            android:id="@+id/collectra_home_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/outfit_semibold"
            android:letterSpacing="-0.03"
            android:text="@string/collectra_brand_name"
            android:textColor="@color/collectra_ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/collectra_custom_home_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/application_name"
        android:maxHeight="160dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/collectra_workspace_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collectra_home_subtext_chip"
        android:padding="12dp"
        android:textColor="@color/collectra_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/collectra_home_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/outfit_semibold"
        android:letterSpacing="-0.035"
        android:lineSpacingMultiplier="0.95"
        android:text="@string/collectra_home_greeting"
        android:textColor="@color/collectra_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collectra_home_tagline"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope_regular"
        android:letterSpacing="0.02"
        android:text="@string/collectra_home_tagline"
        android:textAllCaps="false"
        android:textColor="@color/collectra_text_secondary"
        android:textSize="12sp" />

    <View
        android:id="@+id/collectra_home_accent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@color/collectra_outline" />

    <TextView
        android:id="@+id/collectra_today_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/outfit_semibold"
        android:text="@string/collectra_today_title"
        android:textColor="@color/collectra_text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collectra_today_sync_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/collectra_home_subtext_chip"
        android:padding="12dp"
        android:text="@string/collectra_today_checking_sync"
        android:textColor="@color/collectra_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/collectra_today_start"
        style="@style/Collectra.Workspace.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/collectra_today_start" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/collectra_today_saved"
            style="@style/Collectra.Workspace.Secondary"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/collectra_saved_label" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/collectra_today_resume"
            style="@style/Collectra.Workspace.Secondary"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:text="@string/collectra_drafts_label" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/collectra_today_sync"
        style="@style/Collectra.Workspace.Secondary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/collectra_today_sync" />
</LinearLayout>
