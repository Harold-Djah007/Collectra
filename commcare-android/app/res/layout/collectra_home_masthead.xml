<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/main_top_banner"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/application_name"
            android:scaleType="fitCenter"
            android:src="@drawable/collectra_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/font_outfit"
            android:letterSpacing="-0.02"
            android:text="@string/application_name"
            android:textColor="@color/collectra_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectra_home_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/font_outfit"
        android:letterSpacing="-0.03"
        android:text="@string/collectra_home_greeting"
        android:textColor="@color/collectra_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/font_manrope"
        android:text="@string/collectra_home_tagline"
        android:textColor="@color/collectra_text_secondary"
        android:textSize="14sp" />

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:background="@color/collectra_signal" />
</LinearLayout>
