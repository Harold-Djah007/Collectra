<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collectra_home_masthead_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/main_top_banner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/application_name"
            android:scaleType="fitCenter"
            android:src="@drawable/collectra_mark" />

        <TextView
            android:id="@+id/collectra_home_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/font_outfit"
            android:letterSpacing="-0.03"
            android:text="@string/application_name"
            android:textColor="@color/collectra_ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectra_home_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/font_outfit"
        android:letterSpacing="-0.035"
        android:lineSpacingMultiplier="0.95"
        android:text="@string/collectra_home_greeting"
        android:textColor="@color/collectra_text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collectra_home_tagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/font_manrope"
        android:letterSpacing="0.02"
        android:text="@string/collectra_home_tagline"
        android:textAllCaps="true"
        android:textColor="@color/collectra_text_secondary"
        android:textSize="12sp" />

    <View
        android:id="@+id/collectra_home_accent"
        android:layout_width="56dp"
        android:layout_height="5dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@color/collectra_signal" />
</LinearLayout>
