<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_marginEnd="7dp"
    android:layout_marginBottom="14dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/collectra_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/collectra_divider"
    app:strokeWidth="1dp"
    tools:viewBindingIgnore="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="154dp"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/card_accent"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_alignParentStart="true">

                <org.commcare.views.SquareImageView
                    android:id="@+id/card_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <View
                android:id="@+id/card_marker"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_below="@id/card_accent"
                android:layout_marginTop="15dp"
                android:background="@color/collectra_highlight" />

            <org.commcare.views.ResizingTextView
                android:id="@+id/card_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_marker"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:textColor="@color/collectra_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:text_size_small="14sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/card_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card"
            android:layout_marginTop="10dp"
            android:background="@color/collectra_accent_soft"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/collectra_brand_dark"
            android:textSize="12sp" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
