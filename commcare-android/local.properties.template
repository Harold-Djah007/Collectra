## SDK Directory
#sdk.dir=

## Collectra HQ public/base URL compiled into the APK.
## Required for field builds. Examples:
##   COLLECTRA_HQ_BASE_URL=http://192.168.1.195:8000
##   COLLECTRA_HQ_BASE_URL=https://collectra.example.com
COLLECTRA_HQ_BASE_URL=

## Configure to the file containing your key properties
#file.key.properties=

## Set the below directories to pull in resources from the ant
## build targets from javarosa and commcare (point each to the
## dist folders of those repos)
#build.source=true
#javarosa.libs=
#commcare.libs=
